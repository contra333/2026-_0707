    "per_dataset_result_required_before_macro_summary": true,
    "group_balanced_selection": true
  },
  "integrity_and_parity": {
    "required_full_bundle_status": "LOCAL_COMPLETE_or_independently_REMOTE_VERIFIED_full_bundle",
    "required_bundle_count": 30,
    "allowlist_must_bind": [
      "checkpoint_sha256",
      "config_hash",
      "training_seed",
      "checkpoint_role",
      "remote_uri",
      "relative_path",
      "size",
      "sha256"
    ],
    "missing_or_unexpected_file_policy": "FAILED",
    "required_parity_metrics": [
      "ood_metric/auroc_id_positive",
      "ood_metric/fpr95_id_tpr",
      "ood_metric/fpr95_threshold",
      "ood_metric/fpr95_achieved_id_tpr"
    ],
    "parity_absolute_tolerance": 1e-12,
    "parity_relative_tolerance": 1e-10,
    "status_and_reason_codes_must_match": true,
    "parity_failure_policy": "FAILED"
  },
  "analysis_units": {
    "config_seed_aggregation": "arithmetic_mean_over_selection_seeds_1_and_2_with_seed_values_retained",
    "cross_config_gap": "median_over_all_unique_config_pairs_of_absolute_config_mean_difference",
    "unique_config_pair_count": 45,
    "cross_config_pairs_are_independent_samples": false,
    "uncertainty_resampling_unit": "config_hash_cluster",
    "seed_values_are_nested_within_config": true,
    "ood_datasets_are_not_resampled_as_independent_training_seeds": true,
    "selection_seed_noise": "for_each_candidate_dataset_and_raw_or_transformed_detector_take_abs(metric_config_seed1_minus_metric_config_seed2)_over_the_10_configs",
    "selection_seed_noise_excludes_seed_zero": true,
    "quantile_method": "linear_equivalent_to_numpy_quantile_method_linear"
  },
  "legacy_adam_adamw_contrasts": {
    "direction": "adamw_decoupled_minus_adam_coupled",
    "causal_interpretation": false,
    "primary_discovery_roles": [
      {
        "role_code": "C3",
        "adam_config_hash": "b701f780ad99d469949a985b0472b8d1f26be0545e531d92895b7559ca142328",
