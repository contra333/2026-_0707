        "adamw_config_hash": "61d7d1f20bc593cc2d106f24f0343084f56f811c8ebc63c856eaced34c50b65f",
        "note": "The Adam endpoint is the same unique configuration as Adam C3 and must not be counted twice."
      }
    ],
    "seed_pairing": "same_training_seed_label_within_role",
    "gate_role": "reported_descriptive_contrast_only_not_candidate_eligibility_ranking_or_decision",
    "required_outputs": [
      "raw_signed_gap",
      "transformed_signed_gap",
      "signed_attenuation",
      "magnitude_attenuation",
      "relative_attenuation",
      "overshoot",
      "id_accuracy_gap",
      "id_nll_gap",
      "id_ece_gap"
    ]
  },
  "estimands": {
    "cross_config_raw_gap": "G_D_k_raw = median_(c<c') abs(mean_selection_seeds(M_c_D_k_raw) - mean_selection_seeds(M_c'_D_k_raw))",
    "cross_config_transformed_gap": "G_D_k_T = median_(c<c') abs(mean_selection_seeds(M_c_D_k_T) - mean_selection_seeds(M_c'_D_k_T))",
    "absolute_attenuation": "A_abs_D_k_T = G_D_k_raw - G_D_k_T",
    "relative_attenuation": "A_rel_D_k_T = A_abs_D_k_T / G_D_k_raw when G_D_k_raw > 0",
    "legacy_signed_gap": "delta_role_seed_D_k_T = M_adamw_role_seed_D_k_T - M_adam_role_seed_D_k_T",
    "legacy_signed_attenuation": "A_signed = delta_raw - delta_transformed",
    "legacy_magnitude_attenuation": "A_magnitude = abs(delta_raw) - abs(delta_transformed)",
    "overshoot": "sign(delta_transformed) differs from sign(delta_raw) and abs(delta_transformed) exceeds the practical attenuation margin",
    "primary_stage2_metric": "AUROC",
    "secondary_stage2_metric": "FPR95"
  },
  "practical_margins": {
    "seed_noise_q90": "linear_q90_across_the_10_config_values_abs(raw_auroc_config_seed1_minus_raw_auroc_config_seed2)_for_the_same_candidate_and_dataset",
    "seed_zero_must_not_enter_any_selection_margin": true,
    "raw_gap_margin_auroc": "max(0.01, seed_noise_q90)",
    "attenuation_margin_auroc": "max(0.005, 0.25 * raw_gap, null_attenuation_q90)",
    "minimum_relative_attenuation": 0.25,
    "fpr95_secondary_absolute_margin": 0.02,
    "fpr95_role": "secondary_sensitivity_output_not_used_for_candidate_selection",
    "null_attenuation_q90": "linear_q90_across_six_dataset_values_abs(G_energy_raw_minus_G_energy_feature_transform)_using_selection_seeds_1_and_2_only",
    "practical_reverse": "absolute_attenuation <= -attenuation_margin_auroc",
    "margins_are_computed_for_every_candidate_before_candidate_ranking": true
  },
  "score_overlap": {
    "orientation": "ID_like_higher_is_more_ID",
    "misordering_identity": "1 - AUROC = P(s_ID < s_OOD) + 0.5 * P(s_ID = s_OOD)",
    "pair_matrix_materialization": false,
    "exact_rank_counting_required": true,
    "required_transition_states": [
      "correct",
      "tie",
      "misordered"
    ],
    "required_transition_mass_fields": [
      "correct_to_correct",
      "correct_to_tie",
      "correct_to_misordered",
      "tie_to_correct",
      "tie_to_tie",
      "tie_to_misordered",
      "misordered_to_correct",
      "misordered_to_tie",
      "misordered_to_misordered"
    ],
    "state_definition": {
      "correct": "s_ID_greater_than_s_OOD",
      "tie": "s_ID_equal_to_s_OOD",
      "misordered": "s_ID_less_than_s_OOD"
    },
    "ranking_credit": {
      "correct": 1.0,
      "tie": 0.5,
      "misordered": 0.0
    },
    "corrected_pair_mass": "sum_over_pairs(max(credit_transformed_minus_credit_raw,0))/num_id_ood_pairs",
    "harmed_pair_mass": "sum_over_pairs(max(credit_raw_minus_credit_transformed,0))/num_id_ood_pairs",
    "net_corrected_pair_mass": "corrected_pair_mass_minus_harmed_pair_mass",
    "required_identity_check": "net_corrected_pair_mass_equals_transformed_auroc_minus_raw_auroc_within_exact_auroc_drift_tolerance"
  },
  "invariant_and_witness_policy": {
    "exact_score_tolerance": {
      "absolute": 1e-12,
      "relative": 1e-10
    },
    "exact_rank_disagreement_fraction": 0.0,
    "exact_auroc_drift_tolerance": 1e-12,
    "energy_t1_score_sha256_must_match": true,
    "approximate_knn_l2_auroc_drift_tolerance": 0.001,
    "formula_reconstruction_required": true,
    "formula_reconstruction_scope": "all_30_bundles_full_id_test_and_all_six_ood_query_arrays_for_both_raw_and_transformed_candidate_scores",
    "formula_component_outputs_are_diagnostic_not_selection_thresholds": true,
    "oracle_execution_scope": "candidate_registry_oracle_execution_policy_production_scope",
    "non_invariant_witness_required_for_each_eligible_candidate": true,
    "oracle_failure_policy": "FAILED"
  },
  "cross_validation": {
    "lodo": {
      "fold_count": 6,
      "training_dataset_count_per_fold": 5,
      "minimum_same_candidate_and_heldout_pass_count": 5,
      "heldout_dataset_is_not_used_for_fold_selection": true,
      "fold_recomputation": "recompute_candidate_dataset_summaries_margins_support_and_group_balanced_ranking_using_only_the_five_training_datasets",
      "heldout_absolute_attenuation": "full_10_config_cross_config_raw_gap_minus_transformed_gap_on_the_heldout_dataset",
      "heldout_selective_score": "heldout_absolute_attenuation_divided_by_the_heldout_practical_attenuation_margin",
      "heldout_pass": "heldout_dataset_pass_is_true_and_the_selected_candidate_matches_the_full_data_candidate"
    },
    "loco": {
      "fold_count": 10,
      "training_config_count_per_fold": 9,
      "hold_out_all_seeds_for_config": true,
      "minimum_same_candidate_and_heldout_pass_count": 8,
      "fold_recomputation": "recompute_seed_noise_cross_config_gaps_margins_support_and_ranking_using_only_the_nine_training_configs",
      "heldout_absolute_attenuation_per_dataset": "median_over_9_training_configs_abs(heldout_config_mean_raw_minus_training_config_mean_raw)_minus_median_over_9_training_configs_abs(heldout_config_mean_transformed_minus_training_config_mean_transformed)",
      "heldout_selective_score": "min(median_near(heldout_absolute_attenuation_per_dataset/training_fold_attenuation_margin_per_dataset),median_far(the_same_ratio))",
      "heldout_pass": "heldout_selective_score_greater_than_zero_and_no_heldout_dataset_has_attenuation_less_than_or_equal_to_negative_training_fold_attenuation_margin_and_the_selected_candidate_matches_the_full_data_candidate"
    },
    "seed_stability": {
      "required_views": [
        [
          1
        ],
        [
          2
        ],
        [
          1,
          2
        ]
      ],
      "single_seed_views_use_combined_seed1_and_seed2_frozen_margins": true,
      "seed1_seed2_and_combined_views_must_select_same_candidate": true
    }
  },
  "dataset_support": {
    "minimum_total_dataset_support": 4,
    "minimum_near_dataset_support": 1,
    "minimum_far_dataset_support": 2,
    "near_median_selective_attenuation_must_be_positive": true,
    "far_median_selective_attenuation_must_be_positive": true,
    "no_dataset_may_show_practical_reverse": true,
    "single_dataset_support_is_insufficient": true
  },
  "selection_rule": {
    "candidate_eligibility_requires": [
      "integrity_and_parity_pass",
      "formula_reconstruction_pass",
      "all_exact_null_oracles_pass",
      "non_invariant_witness_pass",
      "raw_gap_exceeds_raw_gap_margin",
      "absolute_attenuation_exceeds_attenuation_margin",
      "relative_attenuation_at_least_0.25",
      "dataset_support_pass",
      "cross_validation_stability_pass",
      "seed_stability_pass"
    ],
    "dataset_selective_score": "Z_candidate_dataset = absolute_attenuation / attenuation_margin",
    "null_controls_enter_ranking": false,
    "null_controls_role": "hard_validity_gate_only",
    "group_balanced_score": "min(median_Z_over_all_near_datasets, median_Z_over_all_far_datasets)",
    "ranking": "descending_group_balanced_score",
    "deterministic_tie_break": [
      "ascending_priority",
      "ascending_candidate_id"
    ],
    "maximum_selected_candidates": 1,
    "diagnostic_only_entries_are_excluded": true
  },
  "decision_semantics": {
    "PASS": "All hard validity gates pass and exactly one eligible focal candidate is selected; a Stage 3 preconfirmation addendum may be frozen.",
    "NO_GO": "Validity checks pass but no candidate satisfies the practical gap and selective-attenuation requirements; do not launch Stage 3.",
    "INCONCLUSIVE": "Formula and validity checks pass and at least one candidate passes the full-data practical criteria, but cross-fold, seed, or dataset-group stability fails; do not launch Stage 3 without a versioned contract revision.",
    "FAILED": "Artifact identity, checksum, scalar parity, formula reconstruction, exact invariant oracle, or required witness failed; do not make a scientific decision.",
    "decision_precedence": [
      "FAILED_if_any_hard_validity_check_fails",
      "NO_GO_if_no_candidate_passes_full_data_practical_and_dataset_support_criteria",
      "INCONCLUSIVE_if_a_full_data_candidate_exists_but_none_passes_all_cross_validation_and_seed_stability_criteria",
      "PASS_select_the_highest_ranked_stable_candidate_with_the_frozen_tie_break"
    ],
    "scientific_launch_allowed_only_for": "PASS",
    "candidate_replacement_to_rescue_result": false
  },
